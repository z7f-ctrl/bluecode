# Bluecode 运行配置模板（可安全提交到 Git）
# 复制为 .env 后填入真实值。.env 已被 .gitignore 排除，绝不会进入版本库。
#
# 这三个变量对应 agent.py 里的 os.environ 读取：
#   MODEL_NAME      模型名（默认 gpt-4o-mini）
#   OPENAI_BASE_URL OpenAI 兼容端点
#   OPENAI_API_KEY  API 密钥

MODEL_NAME=
OPENAI_BASE_URL=
OPENAI_API_KEY=

# 可选：命令白名单（逗号分隔）。设置后 plan_run_command 只允许名单内的命令头，
# 未设置时保持黑名单现状（拦 rm -rf / 管道 / sudo 等危险关键词）。
# 例：BLUE_COMMAND_WHITELIST=python3,pytest,ls,cat
BLUE_COMMAND_WHITELIST=

# 可选：LLM 全文日志开关（调试模型行为）。设为 1 时把每次模型调用的请求/响应全文、
# token usage、耗时写入 ~/.blue/logs/blue-llm-<date>.log。
# 例：BLUE_LOG_LLM=1
BLUE_LOG_LLM=

# 可选：token 单价（美元/百万 token），配置后轮末播报显示本轮成本（≈ $x.xxxx）。
# 两个都空则不显示。
# 例：PRICE_PER_1M_INPUT=2.5  PRICE_PER_1M_OUTPUT=10
PRICE_PER_1M_INPUT=
PRICE_PER_1M_OUTPUT=