# Bluecode 运行配置模板（可安全提交到 Git）
# 复制为 .env 后填入真实值。.env 已被 .gitignore 排除，绝不会进入版本库。
#
# 这三个变量对应 agent.py 里的 os.environ 读取：
#   MODEL_NAME      模型名（默认 gpt-4o-mini）
#   OPENAI_BASE_URL OpenAI 兼容端点
#   OPENAI_API_KEY  API 密钥

MODEL_NAME=
OPENAI_BASE_URL=
OPENAI_API_KEY=

# 可选：命令白名单（逗号分隔）。设置后 plan_run_command 只允许名单内的命令头，
# 未设置时保持黑名单现状（拦 rm -rf / 管道 / sudo 等危险关键词）。
# 例：BLUE_COMMAND_WHITELIST=python3,pytest,ls,cat
BLUE_COMMAND_WHITELIST=

# 可选：LLM 全文日志开关（调试模型行为）。设为 1 时把每次模型调用的请求/响应全文、
# token usage、耗时写入 ~/.blue/logs/blue-llm-<date>.log。
# 例：BLUE_LOG_LLM=1
BLUE_LOG_LLM=

# 可选：token 单价（美元/百万 token），配置后轮末播报显示本轮成本（≈ $x.xxxx）。
# 两个都空则不显示。
# 例：PRICE_PER_1M_INPUT=2.5  PRICE_PER_1M_OUTPUT=10
PRICE_PER_1M_INPUT=
PRICE_PER_1M_OUTPUT=

# 可选：Tavily 搜索 API key（web_search 工具用；https://tavily.com 免费档 1000 次/月）。
# 不配置则 web_search 返回不可用提示，其余功能不受影响。
TAVILY_API_KEY=

# 可选：多模型注册表（/model 命令切换，v0.8）。配置文件 ~/.blue/models.toml（本地
# 不入库），每条目可配 model/base_url/api_key/context_window/note；api_key 与
# base_url 缺省回落上面的 OPENAI_* 变量。示例：
#   [models.gpt4o]
#   model = "gpt-4o"
#   base_url = "https://api.openai.com/v1"
#   context_window = 128000
#   [models.glm]
#   model = "glm-4.6"
#   base_url = "https://open.bigmodel.cn/api/paas/v4"
#   context_window = 200000
#   [active]
#   name = "gpt4o"
# 激活优先级：/model 运行时切换 > MODEL_NAME（命中注册表用其配置）> [active] > 第一个。